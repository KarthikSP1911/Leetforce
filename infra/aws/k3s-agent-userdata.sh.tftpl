#!/bin/bash
# First-boot configuration of a LeetForce k3s agent node (Phase 17, ADR 0029). WRITTEN, NEVER RUN.
# Rendered by Terraform, runs as root through cloud-init on stock Ubuntu 24.04. It does what the
# Ansible role k3s_agent does (ansible/roles/k3s_agent), without Ansible, because the Auto
# Scaling group boots a fresh instance from the AMI. The join token is read from SSM with the
# instance role and kept in a mode 0600 file; it is never printed or put on a command line.
# Safe to re-run.
set -euo pipefail
umask 077

region='${region}'
token_param='${token_param}'
k3s_url='${k3s_url}'
k3s_version='${k3s_version}'
node_label='${node_label}'
node_taint='${node_taint}'

export PATH="$PATH:/snap/bin"

# 1. AppArmor profile for runner pods (userns for nsjail). Same file as the Ansible role.
install -d -m 0755 /etc/apparmor.d
cat >/etc/apparmor.d/leetforce-runner-pod <<'LEETFORCE_PROFILE'
${apparmor_profile}
LEETFORCE_PROFILE
chmod 0644 /etc/apparmor.d/leetforce-runner-pod
apparmor_parser -r /etc/apparmor.d/leetforce-runner-pod

# 2. AWS CLI (Ubuntu cloud images do not ship it). The snap can take a moment on first boot.
if ! command -v aws >/dev/null; then
  for attempt in 1 2 3 4 5; do
    snap install aws-cli --classic && break
    echo "k3s-agent-userdata: snap install aws-cli failed (attempt $attempt)" >&2
    sleep 10
  done
fi
command -v aws >/dev/null || { echo "k3s-agent-userdata: aws cli not available" >&2; exit 1; }

# 3. Join token from SSM. The instance role can take a few seconds to become usable.
install -d -m 0700 /etc/rancher/k3s
ok=0
for attempt in 1 2 3 4 5 6; do
  if aws ssm get-parameter --region "$region" --name "$token_param" --with-decryption \
    --query Parameter.Value --output text >/etc/rancher/k3s/agent-token 2>/dev/null; then
    ok=1
    break
  fi
  echo "k3s-agent-userdata: SSM not reachable yet or $token_param missing (attempt $attempt)" >&2
  sleep 10
done
[ "$ok" = 1 ] || { echo "k3s-agent-userdata: cannot read $token_param (run scripts/k3s/push-agent-token.sh)" >&2; exit 1; }
[ -s /etc/rancher/k3s/agent-token ] || { echo "k3s-agent-userdata: join token is empty" >&2; exit 1; }
chmod 0600 /etc/rancher/k3s/agent-token

# 4. k3s agent configuration: where to join, the isolation label and taint.
cat >/etc/rancher/k3s/config.yaml <<EOF
server: "$k3s_url"
token-file: /etc/rancher/k3s/agent-token
node-label:
  - "$node_label"
node-taint:
  - "$node_taint"
EOF
chmod 0600 /etc/rancher/k3s/config.yaml

# 5. k3s at the pinned version. The installer is saved to a file first (not piped into a shell)
#    and verifies the release checksum itself.
if [ ! -x /usr/local/bin/k3s ]; then
  for attempt in 1 2 3 4 5; do
    curl -fsSL https://get.k3s.io -o /usr/local/sbin/k3s-install.sh && break
    echo "k3s-agent-userdata: downloading the k3s installer failed (attempt $attempt)" >&2
    sleep 10
  done
  chmod 0700 /usr/local/sbin/k3s-install.sh
  INSTALL_K3S_VERSION="$k3s_version" INSTALL_K3S_EXEC=agent /usr/local/sbin/k3s-install.sh
fi

systemctl enable --now k3s-agent
echo "k3s-agent-userdata: k3s agent $k3s_version started, joining $k3s_url"
