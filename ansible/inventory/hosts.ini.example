# Copy to hosts.ini (git-ignored). Addresses come from `terraform output` in infra/aws.
[control]
# leetforce-control ansible_host=<control_public_ip>

[runners]
# leetforce-runner-1 ansible_host=<runner_public_ip>

[k3s_agents]
# leetforce-agent-1 ansible_host=<agent_public_ip> k3s_agent_server_url=https://<control_private_ip>:6443

[all:vars]
ansible_user=ubuntu
