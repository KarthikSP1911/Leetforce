# Copy to .env (git-ignored) and fill in. Never commit real values.

# Upstash Redis connection string (rediss:// TLS URL), provided by the owner.
LEETFORCE_REDIS_URL=

# Local Redis used by tests and `make dev` when LEETFORCE_REDIS_URL is empty.
LEETFORCE_TEST_REDIS_URL=redis://127.0.0.1:6379/0

# Real AWS S3 holds problem test data in every environment (ADR 0021): one bucket, with
# problems/ for test bundles and tfstate/ for Terraform state. The bucket name is globally
# unique and comes from `terraform output` in infra/bootstrap. Leave LEETFORCE_S3_ENDPOINT
# empty to read problems from disk. Leave both keys empty on AWS hosts: they use their IAM
# role. Locally, set an IAM user's keys here; never commit them. (For fully offline work see
# the commented-out RustFS service in docker-compose.yml.)
LEETFORCE_S3_ENDPOINT=
LEETFORCE_S3_ACCESS_KEY=
LEETFORCE_S3_SECRET_KEY=
LEETFORCE_S3_BUCKET=
LEETFORCE_S3_USE_TLS=true
# Region endpoint example: LEETFORCE_S3_ENDPOINT=s3.ap-south-1.amazonaws.com

# Neon Postgres connection string (Phase 4), provided by the owner. Used by the API and
# migrations only; runners never receive it. Cloud: SSM, not a file.
# Quote the value: the URL contains '&', which a shell would treat as a control operator.
DATABASE_URL=''
# Neon direct (non-pooler) endpoint for migrations; falls back to DATABASE_URL when empty.
LEETFORCE_MIGRATE_DATABASE_URL=

# Web (Next.js): where the Go API listens; used server-side and by the /api proxy.
LEETFORCE_API_URL=http://127.0.0.1:8080

# Phase 9: comma-separated proxy addresses whose X-Forwarded-For is believed for per-IP rate limits.
# Use 127.0.0.1 behind the local Next.js proxy; empty means the TCP peer address is always used.
LEETFORCE_TRUSTED_PROXIES=
# Optional per-minute limits (negative turns one off): SUBMIT_USER=10 SUBMIT_IP=30 RUN_USER=20 RUN_IP=60;
# per 10 minutes: AUTH_IP=20 LOGIN_ACCOUNT=10. Leave unset for the defaults.
# LEETFORCE_LIMIT_SUBMIT_USER=

# Phase 11: Grafana admin password for the local observability stack (observability/docker-compose.yml).
LEETFORCE_GRAFANA_PASSWORD=
