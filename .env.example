# Copy to .env (git-ignored) and fill in. Never commit real values.

# Upstash Redis connection string (rediss:// TLS URL), provided by the owner.
LEETFORCE_REDIS_URL=

# Local Redis used by tests and `make dev` when LEETFORCE_REDIS_URL is empty.
LEETFORCE_TEST_REDIS_URL=redis://127.0.0.1:6379/0

# Local MinIO (docker-compose.yml). Choose a password; never commit it.
LEETFORCE_MINIO_USER=leetforce
LEETFORCE_MINIO_PASSWORD=

# Neon Postgres connection string (Phase 4), provided by the owner. Used by the API and
# migrations only; runners never receive it. Cloud: SSM, not a file.
# Quote the value: the URL contains '&', which a shell would treat as a control operator.
DATABASE_URL=''
# Neon direct (non-pooler) endpoint for migrations; falls back to DATABASE_URL when empty.
LEETFORCE_MIGRATE_DATABASE_URL=
